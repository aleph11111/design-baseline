{
  "version": 1,
  "canonical_id": "slug",
  "_note": "slug is the canonical cross-doc identifier; slugs are globally unique. The letter `key` is namespace-scoped display/ordering metadata only and may collide across namespaces. `namespace` defaults to \"baseline\" when absent. See docs/archetypes/README.md for the full convention.",
  "namespaces": {
    "baseline": "Promoted design-baseline donor archetypes (synced via /style-archetypes). Letter keys are the donor's. Target projects add their own namespace(s) for project-local archetypes (anything not in this donor manifest)."
  },
  "plugin": {
    "kind": "design",
    "name": "design-baseline",
    "version": "0.10.2",
    "taxonomy": "docs/TAXONOMY.md",
    "surface": {
      "type": "vite-app",
      "dev": "npm run gallery",
      "build": "npm run gallery:build",
      "dist": "gallery-dist",
      "route": "/a/{slug}"
    },
    "actions": [
      {
        "id": "adopt-baseline",
        "label": "Adopt design-baseline",
        "command": "/style-baseline",
        "scope": "project"
      },
      {
        "id": "adopt-archetype",
        "label": "Adopt archetype",
        "command": "/style-archetypes {key}",
        "scope": "project"
      },
      {
        "id": "iterate-baseline",
        "label": "Iterate design-baseline",
        "command": "design-baseline iteration session",
        "scope": "baseline"
      }
    ]
  },
