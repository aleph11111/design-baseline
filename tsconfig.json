{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "design-baseline": [".design-sync/typecheck-entry.ts"]
    }
  },
  "files": ["src/vite/design-baseline-ui.mjs"],
  "include": ["src/**/*", "gallery/**/*", "vite.config.ts", "vitest.config.ts", ".design-sync/previews/**/*"],
  "exclude": [
    "src/examples/DemoNextApp.tsx",
    "src/examples/DemoViteApp.tsx",
    "node_modules"
  ]
}
