{
  "projectId": "a4e6520e-7e2c-423a-a5f3-577ec80f97cd",
  "shape": "package",
  "pkg": "design-baseline",
  "globalName": "DesignBaseline",
  "entry": ".design-sync/.cache/pkg/barrel.ts",
  "srcDir": "src/components",
  "tsconfig": "../../../tsconfig.json",
  "cssEntry": "styles.css",
  "extraFonts": "fonts/plex.css",
  "readmeHeader": ".design-sync/conventions.md",
  "componentSrcMap": {
    "AppHeader": "src/components/layout/Header.tsx",
    "AppSidebar": "src/components/layout/Sidebar.tsx",
    "SectionNavShell": "src/components/layout/SectionNav.tsx",
    "MetricRow": "src/components/layout/MetricList.tsx"
  },
  "overrides": {
    "Dialog": { "cardMode": "single", "viewport": "560x420", "primaryStory": "Open" },
    "DetailOverviewShell": { "cardMode": "column" },
    "BoardShell": { "cardMode": "column" },
    "ListWithDetailShell": { "cardMode": "column" },
    "MatrixGridShell": { "cardMode": "column" },
    "SettingsTableShell": { "cardMode": "column" },
    "SectionNavShell": { "cardMode": "column" },
    "AppShell": { "cardMode": "single", "viewport": "1160x720", "primaryStory": "Default" },
    "AppSidebar": { "cardMode": "single", "viewport": "1120x680", "primaryStory": "MultipleGroupsAndBottomItems" },
    "AppHeader": { "cardMode": "single", "viewport": "980x170", "primaryStory": "TitleAndActions" },
    "CrudDialogSheet": { "cardMode": "single", "viewport": "620x680", "primaryStory": "EditMode" },
    "CrudDialogHeader": { "cardMode": "single", "viewport": "620x420", "primaryStory": "WithSubtitle" },
    "CrudDialogBody": { "cardMode": "single", "viewport": "620x640", "primaryStory": "TwoColumnLayout" },
    "CrudDialogFooter": { "cardMode": "single", "viewport": "620x420", "primaryStory": "EditMode" },
    "Table": { "cardMode": "column" },
    "Select": { "cardMode": "single", "viewport": "380x440", "primaryStory": "Open" },
    "AlertDialog": { "cardMode": "single", "viewport": "520x320", "primaryStory": "Open" },
    "ConfirmationDialog": { "cardMode": "single", "viewport": "520x320", "primaryStory": "Open" },
    "Sheet": { "cardMode": "single", "viewport": "640x560", "primaryStory": "Open" },
    "Popover": { "cardMode": "single", "viewport": "440x380", "primaryStory": "Open" },
    "DropdownMenu": { "cardMode": "single", "viewport": "380x320", "primaryStory": "Open" },
    "Command": { "cardMode": "single", "viewport": "560x400", "primaryStory": "Open" },
    "Tooltip": { "cardMode": "single", "viewport": "380x240", "primaryStory": "Open" },
    "Pagination": { "cardMode": "column" },
    "Toast": { "cardMode": "single", "viewport": "480x260", "primaryStory": "Default" }
  },
  "buildCmd": "node .design-sync/build-pkg.mjs && npm run gallery:build && cp gallery-dist/assets/index-*.css .design-sync/.cache/pkg/styles.css"
}
