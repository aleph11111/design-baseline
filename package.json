{
  "name": "design-baseline",
  "version": "0.1.0",
  "private": true,
  "description": "Design-baseline donor. Typecheck-only as a library (npx tsc --noEmit); ships an optional donor-dev gallery (npm run gallery) that renders the archetype demos. The gallery harness is NOT part of the baseline broadcast — see STYLE.md.",
  "scripts": {
    "gallery": "vite",
    "gallery:build": "vite build",
    "gallery:preview": "vite preview",
    "gallery:view": "vite build && vite preview --port 5173"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.0",
    "react-hook-form": "^7.53.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "designBaseline": {
    "framework-extras": {
      "next": ["@tailwindcss/postcss"],
      "vite": ["@tailwindcss/vite"]
    },
    "notes": [
      "react / react-dom are in devDependencies for donor typechecking only (npx tsc --noEmit) — target projects pin their own; do not copy the devDependencies block into a target.",
      "Charts (recharts, nivo), auth (next-auth, @supabase/supabase-js), data fetching (@tanstack/react-query) are NOT in the baseline. Add per project.",
      "vite, @vitejs/plugin-react, @tailwindcss/vite, react-router-dom are donor-dev-only — they power the gallery harness (gallery/, vite.config.ts) and are NOT part of the baseline. Never copy them or the gallery into a target."
    ]
  }
}
